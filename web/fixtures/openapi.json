          "time_to_detect_distribution": { "type": "array", "items": { "type": "number" } }
        }
      },
      "AnalyzeRequest": {
        "type": "object",
        "properties": {
          "user_id": { "type": "string" },
          "date_from": { "type": "string" },
          "date_to": { "type": "string" },
