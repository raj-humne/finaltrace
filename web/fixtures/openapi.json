          "first_seen": { "type": "string" },
          "last_seen": { "type": "string" },
          "incident_count": { "type": "integer" },
          "peak_risk": { "type": "number" },
          "max_stage": { "type": "integer" }
        }
      },
      "CampaignListResponse": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/CampaignListItem" } },
          "total": { "type": "integer" }
        }
      },
      "RuleCatalogueItem": {
        "type": "object",
        "properties": {
          "rule_id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "stage": { "type": "integer" },
          "weight": { "type": "number" },
          "requires_baseline": { "type": "boolean" },
          "description": { "type": "string" }
        }
      },
      "RuleListResponse": {
        "type": "object",
        "properties": {
          "config_version": { "type": "string" },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/RuleCatalogueItem" } }
        }
      },
      "RuleStats": {
        "type": "object",
        "properties": {
          "rule_id": { "type": "string" },
          "configured_weight": { "type": "number" },
