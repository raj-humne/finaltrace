            "type": "object",
            "properties": {
              "note": { "type": "string" },
              "items": { "type": "array", "items": { "$ref": "#/components/schemas/AttributionItem" } },
              "minimal_sufficient_set": { "type": "array", "items": { "type": "string" } },
              "alert_threshold": { "type": "number" }
            }
          },
          "campaign": {
            "type": ["object", "null"],
            "properties": {
              "campaign_id": { "type": "string" },
              "incident_count": { "type": "integer" },
              "first_seen": { "type": "string" },
              "last_seen": { "type": "string" },
              "stage_progression": { "type": "array", "items": { "type": "integer" } }
            }
          },
          "status": { "type": "string", "enum": ["open", "closed"] },
          "review": {
            "type": ["object", "null"],
            "properties": {
              "verdict": { "type": "string" },
              "note": { "type": "string" },
              "analyst_id": { "type": "string" },
              "reviewed_at": { "type": "string" }
            }
          },
          "config_version": { "type": "string" },
          "links": {
            "type": "object",
            "properties": { "graph": { "type": "string" }, "export": { "type": "string" } }
          }
        }
      },
      "GraphNode": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
