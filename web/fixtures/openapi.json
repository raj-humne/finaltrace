                  "correlation_points": { "type": "number" },
                  "total_logit": { "type": "number" },
                  "tau": { "type": "number" }
                }
              },
              "confidence_terms": {
                "type": "object",
                "properties": {
                  "agreement": { "type": "number" },
                  "diversity": { "type": "number" },
                  "completeness": { "type": "number" },
                  "maturity": { "type": "number" },
                  "caps_applied": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          },
          "narrative": {
            "type": "object",
            "properties": {
              "headline": { "type": "string" },
              "summary": { "type": "string" },
