            }
          },
          "warnings": { "type": "array", "items": { "type": "string" } }
        }
      },
      "EvalReport": {
        "type": "object",
        "properties": {
          "config_version": { "type": "string" },
          "data_source": { "type": "string" },
          "generated_at": { "type": "string" },
          "primary_metrics": {
            "type": "object",
            "properties": {
              "insider_recall": { "type": "array", "items": { "type": "number" } },
              "incident_precision": { "type": "array", "items": { "type": "number" } },
              "auto_flag_precision": { "type": "array", "items": { "type": "number" } },
              "pr_auc": { "type": "array", "items": { "type": "number" } },
              "median_time_to_detect_days": { "type": "number" }
            }
          },
          "pr_curve": {
            "type": "array",
            "items": { "type": "object", "properties": { "precision": { "type": "number" }, "recall": { "type": "number" } } }
          },
