          "verdict": { "type": "string" },
          "reviewed_at": { "type": "string" },
          "incident_status": { "type": "string" },
          "suppression": { "type": ["object", "null"], "properties": { "status": { "type": "string" } } },
          "effects": {
            "type": "object",
            "properties": {
              "rule_stats_updated": { "type": "array", "items": { "type": "string" } },
              "user_risk_ewma_adjusted": { "type": "boolean" }
            }
          }
        }
      },
      "CampaignStageEvent": {
        "type": "object",
        "properties": {
          "date": { "type": "string" },
          "stage": { "type": "integer" },
          "incident_id": { "type": "string" },
          "risk": { "type": "number" },
          "headline": { "type": "string" }
        }
      },
      "Campaign": {
        "type": "object",
        "properties": {
          "campaign_id": { "type": "string" },
          "user_id": { "type": "string" },
          "first_seen": { "type": "string" },
          "last_seen": { "type": "string" },
