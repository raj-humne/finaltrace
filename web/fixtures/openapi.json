          "fire_rate_per_user_day": { "type": "number" },
          "reviewed": { "type": "integer" },
          "confirmed": { "type": "integer" },
          "benign": { "type": "integer" },
          "inconclusive": { "type": "integer" },
          "observed_precision": { "type": "number" },
          "measured_log_odds": { "type": "number" },
          "weight_drift": { "type": "number" },
          "recommendation": { "type": "string" }
        }
      },
      "DetectionHealth": {
        "type": "object",
        "properties": {
          "window": { "type": "object", "properties": { "from": { "type": "string" }, "to": { "type": "string" } } },
