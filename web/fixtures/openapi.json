      "AnalyzeResponse": {
        "type": "object",
        "properties": {
          "user_id": { "type": "string" },
          "window": { "type": "object", "properties": { "from": { "type": "string" }, "to": { "type": "string" } } },
          "computed_in_ms": { "type": "integer" },
